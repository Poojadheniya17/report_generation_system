# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DEBUG=true

# Postgres (Railway gives you this connection string)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tripp

# Set this to the SAME secret you enter in the Typeform webhook UI.
# Leave blank ONLY for local curl testing (requests will be accepted unsigned).
TYPEFORM_WEBHOOK_SECRET=

# Week 2
ANTHROPIC_API_KEY=
