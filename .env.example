# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DEBUG=true

# Postgres (Railway gives you this connection string automatically once you
# add a Postgres service to your Railway project — copy it from there).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tripp

# Set this to the SAME secret you enter in the Typeform webhook UI.
# Leave blank ONLY for local curl testing (requests will be accepted unsigned).
TYPEFORM_WEBHOOK_SECRET=

# Personal Access Token — used only by scripts/setup_webhook.py to talk to
# Typeform's Management API (list forms, list fields, register/inspect/
# delete webhooks). Different from TYPEFORM_WEBHOOK_SECRET above. Note:
# scripts/setup_webhook.py reads this from the terminal environment or
# --token, NOT from this .env file — set it with $env:TYPEFORM_TOKEN or
# pass --token when running that script directly.
TYPEFORM_TOKEN=

# Claude
ANTHROPIC_API_KEY=
# Model + token limit for the interpretation step. Safe to leave blank —
# defaults to claude-sonnet-4-6 / 8000 tokens.
INTERPRETATION_MODEL=
INTERPRETATION_MAX_TOKENS=

# Portal — single shared password (Tripp is the only user). Set a real
# secret_key before deploying anywhere real; it signs the session cookie.
PORTAL_PASSWORD=
SECRET_KEY=

# Cloudflare R2 (PDF storage in production). Leave ALL FOUR blank for local
# dev — the app automatically falls back to saving PDFs on local disk when
# these aren't set, so local testing needs no R2 setup at all. Required in
# production (Railway), since local disk there gets wiped on every restart.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
